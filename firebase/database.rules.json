{
  "rules": {
    ".read": false,
    ".write": false,

    "submissions":           { ".read": true, ".write": true },
    "general_visits":        { ".read": true, ".write": true },
    "meditation":            { ".read": true, ".write": true },
    "motherday-submissions": { ".read": true, ".write": true },
    "scout-users":           { ".read": true, ".write": true },
    "homecheckin_config":    { ".read": true, ".write": true },
    "homecheckin_meta":      { ".read": true, ".write": true },
    "homecheckin_photo":     { ".read": true, ".write": true },

    "checkin2_meta": {
      ".read": true,
      ".indexOn": ["ts", "sid"],
      "$id": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['name', 'sid', 'lat', 'lon', 'ts'])",
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
        "sid":  { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{11}$/)" },
        "lat":  { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
        "lon":  { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
        "acc":  { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "ts":   { ".validate": "newData.isNumber() && newData.val() <= now + 600000 && newData.val() >= now - 172800000" },
        "g":    { ".validate": "newData.isString() && newData.val().length <= 100" },
        "d":    { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "in":   { ".validate": "newData.isBoolean()" },
        "rid":  { ".validate": "newData.isString() && newData.val().length <= 40" },
        "dev":  { ".validate": "newData.isString() && newData.val().length <= 60" },
        "ph":   { ".validate": "newData.val() === 1" },
        "$other": { ".validate": false }
      }
    },

    "checkin2_photo": {
      ".read": true,
      "$id": {
        ".write": "!data.exists() || !newData.exists()",
        ".validate": "newData.isString() && newData.val().length < 400000 && newData.val().beginsWith('data:image/jpeg;base64,')"
      }
    },

    "checkin2_config": { ".read": true, ".write": true },
    "checkin2_rounds": { ".read": true, ".write": true }
  }
}
